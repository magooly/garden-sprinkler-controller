[Unit]
Description=Garden sprinkler controller and master pump
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Documents/garden-sprinkler-controller
ExecStart=%h/Documents/garden-sprinkler-controller/.venv/bin/python %h/Documents/garden-sprinkler-controller/service.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
RuntimeDirectory=garden-sprinkler-controller
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
